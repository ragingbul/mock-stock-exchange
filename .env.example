# Application
APP_NAME=Mock Stock Exchange
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL (matches docker-compose defaults)
POSTGRES_USER=mse
POSTGRES_PASSWORD=mse_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mock_stock_exchange

# Optional URL override (useful without Docker). Example:
# DATABASE_URL=sqlite+pysqlite:///./mse_dev.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
AUTO_INIT_DB=true

# Auth (replace for any real deployment)
JWT_SECRET=change-me-in-production-phase-0
ADMIN_SECRET=change-me-admin-secret
AUTH_TOKEN_EXPIRE_MINUTES=720
RATE_LIMIT_PER_MINUTE=600

# Simulation
SIMULATION_SPEED=1

# Market defaults (used from Phase 1+)
DEFAULT_STARTING_CAPITAL=1000000
DEFAULT_TICK_SIZE=0.05
DEFAULT_CIRCUIT_PCT=0.10
RANDOM_SEED=42

# Event volatility (amplify news + AI reactions for bigger swings)
MARKET_INTENSITY_MULTIPLIER=3.0
NEWS_PRESSURE_AMPLIFIER=2.5
NEWS_PRESSURE_CAP=3.0
NEWS_FUNDAMENTAL_MULTIPLIER=2.0
NEWS_DECAY_TAIL_FACTOR=0.35
MM_SPREAD_BPS=140
MM_QUOTE_SIZE=35
MM_MIN_BOOK_DEPTH=20
MARKET_NOISE_STD=0.08
MARKET_NEWS_WEIGHT=0.45

# Frontend (build-time on Railway — set in frontend service variables)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_API_PREFIX=/api/v1

# Railway production example:
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
# NEXT_PUBLIC_WS_URL=wss://your-api.up.railway.app
# DATABASE_URL is injected by Railway Postgres plugin (postgresql:// — auto-normalized to +psycopg)

# ---------------------------------------------------------------------------
# Oracle Cloud Always Free (OCI) production — docker-compose.prod.yml
# Replace YOUR_PUBLIC_IP with the VM public IP (or https://your-hostname).
# Generate TLS: ./scripts/oci/generate-self-signed-cert.sh YOUR_PUBLIC_IP
# Deploy: ./scripts/oci/deploy.sh
# ---------------------------------------------------------------------------
# ENVIRONMENT=production
# DEBUG=false
# AUTO_INIT_DB=false
# SIMULATION_SPEED=1
# POSTGRES_USER=mse
# POSTGRES_PASSWORD=generate-a-strong-password
# POSTGRES_DB=mock_stock_exchange
# DATABASE_URL=postgresql+psycopg://mse:generate-a-strong-password@postgres:5432/mock_stock_exchange
# JWT_SECRET=generate-at-least-32-characters-for-production
# ADMIN_SECRET=generate-a-strong-admin-password
# FRONTEND_URL=https://YOUR_PUBLIC_IP
# BACKEND_URL=https://YOUR_PUBLIC_IP
# CORS_ORIGINS=https://YOUR_PUBLIC_IP
# NEXT_PUBLIC_API_URL=https://YOUR_PUBLIC_IP
# NEXT_PUBLIC_WS_URL=wss://YOUR_PUBLIC_IP
# NEXT_PUBLIC_API_PREFIX=/api/v1
#
# Rehearsal only (do not use for live event): SIMULATION_SPEED=60

# ---------------------------------------------------------------------------
# Local LAN server — docker-compose.local.yml (see LOCAL_SERVER.md)
# Copy .env.local.example to .env, set LAN IP in CORS_ORIGINS
# Leave NEXT_PUBLIC_* empty for same-origin auto
# ---------------------------------------------------------------------------
