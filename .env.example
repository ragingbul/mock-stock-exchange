# TRADEVERSE — cloud deployment (Vercel + Supabase + API worker)
# Copy to .env for local API development only. Production secrets live in Vercel / Railway / Supabase dashboards.

# --- API worker (Railway or Render) ---
ENVIRONMENT=production
DEBUG=false
AUTO_INIT_DB=false
SIMULATION_SPEED=1

# Supabase Postgres — use direct connection (port 5432), not transaction pooler, for the Python worker
# Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

JWT_SECRET=generate-at-least-32-characters-for-production
ADMIN_SECRET=generate-a-strong-admin-password

# Vercel frontend URL(s) — include preview domain if needed
FRONTEND_URL=https://your-app.vercel.app
BACKEND_URL=https://your-api.up.railway.app
CORS_ORIGINS=https://your-app.vercel.app,https://your-app-*.vercel.app

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# --- Vercel (frontend build-time) ---
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
NEXT_PUBLIC_WS_URL=wss://your-api.up.railway.app
NEXT_PUBLIC_API_PREFIX=/api/v1

# --- Local dev only (optional) ---
# ENVIRONMENT=development
# DEBUG=true
# AUTO_INIT_DB=true
# DATABASE_URL=sqlite+pysqlite:///./backend/mse_dev.db
# CORS_ORIGINS=http://localhost:3000
# FRONTEND_URL=http://localhost:3000
# BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000
