# Application
APP_NAME=Mock Stock Exchange
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (matches docker-compose defaults)
POSTGRES_USER=mse
POSTGRES_PASSWORD=mse_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mock_stock_exchange

# Auth (replace for any real deployment)
AUTH_SECRET_KEY=change-me-in-production-phase-0
AUTH_TOKEN_EXPIRE_MINUTES=720

# Market defaults (used from Phase 1+)
DEFAULT_STARTING_CAPITAL=1000000
DEFAULT_TICK_SIZE=0.05
DEFAULT_CIRCUIT_PCT=0.10
RANDOM_SEED=42

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
