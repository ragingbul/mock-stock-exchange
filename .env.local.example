# TRADEVERSE local LAN server — copy to .env before starting
# cp .env.local.example .env   (or merge into your existing .env)

ENVIRONMENT=production
DEBUG=false
AUTO_INIT_DB=false
SIMULATION_SPEED=1

POSTGRES_USER=mse
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_DB=mock_stock_exchange

JWT_SECRET=change-me-local-jwt-secret-min-32-chars!!
ADMIN_SECRET=change-me-admin-secret

# Include localhost AND your laptop LAN IP (run: ipconfig → IPv4 Address)
# Update when your Wi-Fi IP changes, then restart backend:
#   docker compose -f docker-compose.local.yml restart backend
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://192.168.1.42
FRONTEND_URL=http://192.168.1.42
BACKEND_URL=http://192.168.1.42

# Leave empty for same-origin auto (works for localhost and LAN IP without rebuild)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_API_PREFIX=/api/v1

# Rehearsal testing only (not live event): SIMULATION_SPEED=60
